<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit campground</title>
</head>
<body>
    <form action="/campgrounds/<%= campground._id %>?_method=put" method="post">
        <div>
            <label for="title">Title</label>
            <input value="<%= campground.title %>" type="text" name="campground[title]" id="title">
        </div>

        <div>
            <label for="location">Location</label>
            <input value="<%= campground.location %>" type="text" name="campground[location]" id="location">
        </div>

        <button>Update Campground</button>
    </form>

    <a href="/campgrounds/<%= campground._id %>">Back to campground</a>
</body>
</html>