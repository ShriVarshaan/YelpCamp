<% layout("layouts/boilerplate") %>

<div class="row">
    <div class="col-12">
        <h1 class="text-center">New campground</h1>
        <div class="col-6 offset-3">
            <form action="/campgrounds/<%= campground._id %>?_method=put" method="post">
                <div class="mb-2">
                    <label class="form-label" for="title">Title</label>
                    <input value="<%= campground.title %>" class="form-control" type="text" name="campground[title]" id="title">
                </div>

                <div class="mb-2">
                    <label class="form-label" for="location">Location</label>
                    <input value="<%= campground.location %>" class="form-control" type="text" name="campground[location]" id="location">
                </div>

                <div class="mb-3">
                    <label class="form-label" for="image">Image URL</label>
                    <input value="<%= campground.image %>" class="form-control" type="text" name="campground[image]" id="image">
                </div>

                <div class="input-group mb-2">
                    <div class="input-group-prepend">
                        <span class="input-group-text">$</span>
                    </div>
                    <input value="<%= campground.price %>" name="campground[price]" id="price" type="text" class="form-control" aria-label="Amount (to the nearest dollar)">
                    <div class="input-group-append">
                        <span class="input-group-text">.00</span>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label" for="description">Description</label>
                    <textarea class="form-control" type="text" name="campground[description]" id="description"><%= campground.description %></textarea>
                </div>

                <button class="btn btn-success mb-2">Add Campground</button>
            </form>

            <a class="btn btn-primary" href="/campgrounds/<%= campground._id %>">Back to campground</a>

        </div>
    </div>
    
</div>
