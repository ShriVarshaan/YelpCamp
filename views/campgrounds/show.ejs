<% layout("layouts/boilerplate") %>

<div class="row">
    <div class="col-6">
        <div class="card">
            <img src="<%= campground.image %>" class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title"><%= campground.title %></h5>
                <p class="card-text"><%= campground.description %></p>
            </div>
            <div class="card-body">
                <form action="/campgrounds/<%= campground._id %>?_method=delete" method="post">
                    <button class="btn btn-danger">Delete</button>
                    <a class="btn btn-primary" href="/campgrounds/<%= campground._id %>/edit">Edit campground</a>
                </form>
            
            </div>
        </div>
    </div>
    <div class="col-6">
        <h2>Leave a review</h2>

        <form novalidate class="mb-3 validated-form" action="/campgrounds/<%= campground._id %>/reviews" method="post">
            <div class="mb-3">
                <label for="rating" class="form-label">Rating</label>
                <input class="form-range" id="rating" name="review[rating]" type="range" min="1" max="5" class="form-control">
            </div>
            <div class="mb-3">
                <label class="form-label" for="reviewBody">Review:</label>
                <textarea class="form-control" name="review[body]" id="reviewBody" cols="30", rows="3"></textarea>
            </div>
            <button class="btn-success">Add review</button>
        </form>

        <% if (campground.reviews) { %>
            <div class="mb-3">
                <% for( let index = 0; index < campground.reviews.length; index++ ) { %>
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Rating: <%= campground.reviews[index].rating %></h5>
                            <p class="card-text">Reviews: <%= campground.reviews[index].body %></p>
                            <form action="/campgrounds/<%= campground._id %>/reviews/<%= campground.reviews[index]._id %>?_method=delete" method="post">
                                <button class="btn btn-danger">delete</button>
                            </form>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
            
        </div>
    </div>
</div>
